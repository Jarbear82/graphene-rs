        .unwrap()
        .clone();
    let weights_med = f_med.weights.clone();
    let edge_keys_med = f_med.state.edge_keys.clone();
    let mut weighted_med = WeightedForceDirectedLayout {
        iterations: 100,
        gravity: 1.0,
        k_rep: 30.0,

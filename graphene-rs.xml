                id: 2,
                source: "Z",
                target: "X",
            },
        ];

        let result = BellmanFordResult::<&str>::run(
            edges,
            "X",
            |e| match e.id {
                0 => -1.0,
                1 => -1.0,
                _ => -5.0,
            }, // Negative cycle
            true,

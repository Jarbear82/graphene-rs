    #[test]
    fn test_kruskal_example() {
        let edges = vec![
            Edge {
                source: 0,
                target: 1,
                weight: 4.0,
            },
            Edge {
                source: 0,
                target: 2,
                weight: 3.0,
            },
            Edge {
                source: 1,

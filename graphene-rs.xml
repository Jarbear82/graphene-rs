        let g2 = f
            .state
            .add_node(Vec2::new(-10.0, 20.0), Size2::new(30.0, 25.0));
        f.node_labels.insert(g1, "TP53".to_string());
        f.node_labels.insert(g2, "BRCA1".to_string());

        f.state.reparent_node(g1, Some(nucleus));
        f.state.reparent_node(g2, Some(nucleus));

        let r1 = f
